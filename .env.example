# =============================================================================
# Firebase Client (public — safe to expose in the browser)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional App Check (reCAPTCHA v3)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Connect client SDK to local emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Seed script only — connect Admin SDK to emulators (Auth 9099, Firestore 8080, Storage 9199)
# Usage: USE_EMULATOR=true npm run seed
# USE_EMULATOR=true

# =============================================================================
# Firebase Admin (server-only — never expose to the client)
# =============================================================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Escape newlines as \n when storing in env
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.appspot.com

# =============================================================================
# Session cookies (Firebase Auth session cookie via Admin SDK)
# =============================================================================
SESSION_COOKIE_NAME=__session
# Duration in seconds (e.g. 60 * 60 * 24 * 5 = 5 days)
SESSION_COOKIE_MAX_AGE=432000
SESSION_COOKIE_SECURE=true

# =============================================================================
# Site
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://rjbuildz.com

# =============================================================================
# Contact form
# =============================================================================
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_RATE_LIMIT_PER_HOUR=5
# Optional — if set, contact messages are also emailed via Resend
RESEND_API_KEY=
