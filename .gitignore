# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/functions/lib

# misc
.DS_Store
*.pem
*.psd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firebase-debug.*.log
ui-debug.log
firestore-debug.log
pubsub-debug.log
storage-debug.log

# env files — keep .env.example committable
.env
.env.*
!.env.example

# local secrets / service accounts
*firebase-adminsdk*.json
serviceAccount*.json
*-service-account.json
.secrets/

# firebase emulator persistence
.firebase-data/
.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
