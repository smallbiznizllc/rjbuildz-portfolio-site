rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidContactMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'read'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches('.*@.*\\..*')
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 200))
        && data.read == false
        && data.createdAt is timestamp
        && data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'read', 'source', 'userAgent']);
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /featureTags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /createdWithTags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if isValidContactMessage();
      allow read, update, delete: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
